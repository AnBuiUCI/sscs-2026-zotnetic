+ v(SX4) v(SY4) v(SZ4) v(XY4) v(XZ4) v(YZ4)
+ v(X4) v(Y4) v(Z4)
* case 17: c = (-0.3, +1.0, -0.6)  ->  expected Z
alter Vcx = -0.3
alter Vcy = 1.0
