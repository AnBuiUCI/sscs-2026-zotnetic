alter Vcy = -0.3
alter Vcz = -1.0
dc Vamp 200u 0.02 200u
wrdata oct_12.txt v(cx) v(cy) v(cz) v(S1P) v(S1N) v(S2P) v(S2N) v(S3P) v(S3N)
