alter Vcy = -1.0
alter Vcz = -0.6
dc Vamp 200u 0.02 200u
wrdata oct_11.txt v(cx) v(cy) v(cz) v(S1P) v(S1N) v(S2P) v(S2N) v(S3P) v(S3N)
+ v(x3.SX) v(x3.SY) v(x3.SZ) v(x3.net1) v(x3.net2) v(x3.net3)
+ v(X2) v(Y2) v(Z2)
+ v(SX4) v(SY4) v(SZ4) v(XY4) v(XZ4) v(YZ4)
+ v(X4) v(Y4) v(Z4)
